# Browser-visible Supabase project configuration only. Never place service-role,
# database, or other server secrets in VITE_* variables.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Member login: Google. Owner/admin login: allowlisted GitHub.
# Both providers must be configured server-side; no provider secrets belong here.

# GitHub Pages production default is /SpotInfo/. Override only for another Pages path.
VITE_BASE_PATH=/SpotInfo/

# Optional production Photon-compatible endpoint. The default is public
# Photon and is submission-only, throttled, and cached in memory.
VITE_GEOCODING_URL=

# Optional tile endpoint for a provider or self-hosted OSM tiles at scale.
# The default is https://tile.openstreetmap.org/{z}/{x}/{y}.png.
VITE_TILE_URL=
