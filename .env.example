# Browser-visible Firebase Web App configuration only. Never place service-account,
# Admin SDK, private key, or other server secrets in VITE_* variables.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
# Optional
VITE_FIREBASE_MESSAGING_SENDER_ID=

# Firebase Hosting serves this application at the domain root.
VITE_BASE_PATH=/

# Optional production Photon-compatible endpoint. The default is public Photon and
# is submission-only, throttled, and cached in memory.
VITE_GEOCODING_URL=

# Optional tile endpoint for a provider or self-hosted OSM tiles at scale.
# The default is https://tile.openstreetmap.org/{z}/{x}/{y}.png.
VITE_TILE_URL=
